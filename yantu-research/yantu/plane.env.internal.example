# Put these values in Plane's generated plane.env for PHASE 1 on your own PC.
# Two names on your own computer must resolve to 127.0.0.1 (Windows hosts file).
APP_RELEASE=v1.4.2
APP_DOMAIN=plane.lab.test
SITE_ADDRESS=http://plane.lab.test
WEB_URL=http://plane.lab.test
CORS_ALLOWED_ORIGINS=http://plane.lab.test
YANTU_SITE_ADDRESS=http://research.lab.test
CERT_EMAIL=
INTERNAL_BIND_IP=127.0.0.1
YANTU_DATABASE_URL=postgresql+psycopg://plane:REPLACE_SAME_POSTGRES_PASSWORD@plane-db:5432/plane
# Add after you have created a Plane project and API key:
PLANE_API_KEY=
PLANE_ALLOWED_PROJECTS=
# Included in the local Docker Compose profile "ai"; pull this model before asking questions:
AI_BASE_URL=http://ollama:11434
AI_MODEL=qwen2.5:3b

# For PHASE 2 change INTERNAL_BIND_IP to the server's IP reachable ONLY over VPN.
# Map both .lab.test names to that VPN/private IP on members' computers.
# Do not expose website ports 80 or 443 in the cloud's public security group.
